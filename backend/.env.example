# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/abuhub

# Server Configuration
PORT=5000
NODE_ENV=development

# Prisma (SQLite local)
DATABASE_URL="file:./dev.db"

# JWT Configuration (Authentication)
JWT_SECRET=your_jwt_secret_key_min_32_chars_recommended
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_recommended

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@example.com
NOTIFY_EMAILS=admin@example.com
# Token used to sign email action links (approve/delete). If not set, JWT_SECRET will be used.
EMAIL_ACTION_SECRET=your_email_action_secret_min_32_chars
EMAIL_ACTION_EXPIRES=7d
EMAIL_ACTION_REQUIRE_ADMIN=true

# CAPTCHA (optional but recommended for public testimonial submission)
CAPTCHA_REQUIRED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
CAPTCHA_MIN_SCORE=0.5

# Public testimonial rate-limit
TESTIMONIAL_RATE_LIMIT_WINDOW_MS=600000
TESTIMONIAL_RATE_LIMIT_MAX=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# API Configuration
API_URL=http://localhost:5000
